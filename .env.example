# TreeForge 配置示例
#
# 用法：复制为 .env 后填入真实值
#   cp .env.example .env
#
# .env 已在 .gitignore 内，不会被提交（含密钥，勿提交）。
# 解析规则（harness/config.py）：KEY=VALUE，支持引号包裹、# 注释、空行。

# ============================================================================
# LLM 配置（init-plan §7.2）
# ============================================================================

# 【必填】LLM API Key
LLM_KEY=

# LLM 服务端点。harness/llm.py 按以下规则自动探测协议：
#   - URL 含 "anthropic.com" 或 "/anthropic" 路径段 → Anthropic Messages 协议
#     （POST {base}/v1/messages，头 x-api-key + anthropic-version）
#   - 其它 → OpenAI 兼容协议
#     （POST {base}/v1/chat/completions，头 Authorization: Bearer）
# 官方 Anthropic：
LLM_BASE=https://api.anthropic.com
# 智谱 BigModel（Anthropic 兼容网关，/anthropic 路径段触发 Anthropic 协议）：
# LLM_BASE=https://open.bigmodel.cn/api/anthropic
# OpenAI 兼容（如 DeepSeek、Moonshot、自建网关）：
# LLM_BASE=https://api.deepseek.com

# 跳过 TLS 证书校验（自签证书 / 企业 MITM 网关用）。1/true/yes 开启。
# 默认 false。server 层（P1）会强制设为 true。
LLM_INSECURE=false

# 蒸馏模型（强推理，Opus 级）—— DISTILL 阶段 + playbook 用
DISTILL_MODEL=claude-opus-4-8

# 分类模型（快/省，Haiku 级）—— CLASSIFY / consolidate / query 用
# 自建网关若无 Haiku 级模型，可设为和 DISTILL_MODEL 一样
CLASSIFY_MODEL=claude-haiku-4-5

# 请求超时（秒）、重试次数（指数退避，封顶 8s）
LLM_TIMEOUT=180
LLM_RETRIES=6

# 单次请求最大输出 token
DISTILL_MAX_TOKENS=16384
CLASSIFY_MAX_TOKENS=2048

# ============================================================================
# 管线参数（对齐 Browser-BC 默认值，一般不用改）
# ============================================================================

# 桶蒸馏的最小 segment 数（1 = 单条录制即可蒸馏，P0 验收需要）
MIN_BUCKET_SIZE=1

# 单 segment 最大事件数（超过则拆分）
MAX_SEGMENT_EVENTS=80

# ============================================================================
# 输出路径
# ============================================================================

# skill 文件输出根目录（CLI --output 优先级更高）
# treewalker adapter 落到 {OUTPUT_DIR}/domain-skills/<host>/_sop.md 等
# browserbc adapter 落到 {OUTPUT_DIR}/skills/<domain>/<capacity>/SKILL.md
# 相对路径以仓库根为基准。默认 ./data/skills
# OUTPUT_DIR=./data/skills

# ============================================================================
# 默认输出 adapter（CLI --adapter 优先级更高）
# ============================================================================

# treewalker（默认，多文件给 TreeWalker 文件注入）| browserbc（单 SKILL.md，学习对照用）
DEFAULT_ADAPTER=treewalker
